{% if schema_exists and service_exists %}
{% if repository_exists and session_exists %}
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.db.session import get_session
from app.repositories.{{ snake_name }} import {{ name }}Repository
from app.schemas.{{ snake_name }} import {{ name }}Create, {{ name }}Response, {{ name }}Update
from app.services.{{ snake_name }} import {{ name }}Service


router = APIRouter(
    prefix="/{{ snake_name }}",
    tags=["{{ name }}"],
)


def get_{{ snake_name }}_service(
    session: AsyncSession = Depends(get_session),
) -> {{ name }}Service:
    repository = {{ name }}Repository(session)
    return {{ name }}Service(repository)
{% else %}
from fastapi import APIRouter, Depends, HTTPException, status

from app.schemas.{{ snake_name }} import {{ name }}Create, {{ name }}Response, {{ name }}Update
from app.services.{{ snake_name }} import {{ name }}Service


router = APIRouter(
    prefix="/{{ snake_name }}",
    tags=["{{ name }}"],
)


def get_{{ snake_name }}_service() -> {{ name }}Service:
    raise NotImplementedError(
        "Configure the {{ name }}Service dependency with a repository instance."
    )
{% endif %}


@router.get("/", response_model=list[{{ name }}Response])
async def list_{{ plural_snake_name }}(
    service: {{ name }}Service = Depends(get_{{ snake_name }}_service),
) -> list[{{ name }}Response]:
    return await service.list()


@router.get("/{id}", response_model={{ name }}Response)
async def get_{{ snake_name }}(
    id: int,
    service: {{ name }}Service = Depends(get_{{ snake_name }}_service),
) -> {{ name }}Response:
    result = await service.detail(id)

    if result is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ name }} not found",
        )

    return result


@router.post(
    "/",
    response_model={{ name }}Response,
    status_code=status.HTTP_201_CREATED,
)
async def create_{{ snake_name }}(
    data: {{ name }}Create,
    service: {{ name }}Service = Depends(get_{{ snake_name }}_service),
) -> {{ name }}Response:
    return await service.create(data)


@router.put("/{id}", response_model={{ name }}Response)
async def update_{{ snake_name }}(
    id: int,
    data: {{ name }}Update,
    service: {{ name }}Service = Depends(get_{{ snake_name }}_service),
) -> {{ name }}Response:
    result = await service.update(id, data)

    if result is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ name }} not found",
        )

    return result


@router.delete(
    "/{id}",
    status_code=status.HTTP_204_NO_CONTENT,
)
async def delete_{{ snake_name }}(
    id: int,
    service: {{ name }}Service = Depends(get_{{ snake_name }}_service),
) -> None:
    deleted = await service.delete(id)

    if not deleted:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="{{ name }} not found",
        )
{% else %}
from fastapi import APIRouter


router = APIRouter(
    prefix="/{{ snake_name }}",
    tags=["{{ name }}"],
)


@router.get("/")
async def index():
    return {"message": "{{ name }} router"}
{% endif %}
